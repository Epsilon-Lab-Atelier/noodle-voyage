      ],
      "evidence": "name_explicit:もつ・ホルモン"
    },
    {
      "pattern": "豆腐",
      "facetIds": [
        "tofu"
      ],
      "evidence": "name_explicit:豆腐"
    },
    {
      "pattern": "ミルキー|牛乳",
      "facetIds": [
        "dairy"
      ],
      "evidence": "name_explicit:乳製品"
    },
    {
      "pattern": "天ぷら|カツ|トンカツ",
      "facetIds": [
        "tempura"
      ],
      "evidence": "name_explicit:揚げ物"
    },
    {
      "pattern": "生姜|しょうが",
      "facetIds": [
        "ginger"
      ],
      "evidence": "name_explicit:生姜"
    },
    {
      "pattern": "背脂",
      "facetIds": [
        "backfat"
      ],
      "evidence": "name_explicit:背脂"
    },
    {
      "pattern": "酒粕",
      "facetIds": [
        "sake_lees",
        "fermented"
      ],
      "evidence": "name_explicit:酒粕"
    },
    {
      "pattern": "茶ラーメン|茶そば",
      "facetIds": [
        "tea"
      ],
      "evidence": "name_explicit:茶"
    },
    {
      "pattern": "玉子|卵",
      "facetIds": [
        "egg"
      ],
      "evidence": "name_explicit:卵"
    },
    {
      "pattern": "タンメン|ちゃんぽん|ガタタン",
      "facetIds": [
        "vegetables"
      ],
      "evidence": "name_explicit:野菜系"
    },
    {
      "pattern": "沖縄そば",
      "facetIds": [
        "okinawa_soba_noodle"
      ],
      "evidence": "name_explicit:沖縄そば麺"
    },
    {
      "pattern": "太平燕",
      "facetIds": [
        "glass_noodle"
      ],
      "evidence": "name_explicit:春雨・でん粉麺"
    },
    {
      "pattern": "雲呑|ワンタン",
      "facetIds": [
        "wonton"
      ],
      "evidence": "name_explicit:雲呑"
    }
  ],
  "output": {
    "facetIndex": "data/facets/facet-index.seed.json",
    "flatEvidence": "data/facets/facet-evidence.csv",
    "manualOverrides": "data/facets/manual-review-overrides.json",
    "reviewQueue": "data/facets/review-queue.csv"
  }
}
