      "facetIds": [
        "seafood_ingredient",
        "seafood_forward"
      ],
      "evidence": "name_explicit:魚介素材"
    },
    {
      "pattern": "辛|タンタン|担々|ベトコン",
      "facetIds": [
        "spicy"
      ],
      "evidence": "name_explicit:辛味"
    },
    {
